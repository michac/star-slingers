{
  // Browser code only: the game (src/) and the prototype shelf. No Node types
  // here, so `process` or `Buffer` in game code fails to type-check
  // (src/no-node-globals.ts guards that). Node-side files are in tsconfig.node.json.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "prototype"]
}
