{
  // The e2e suite + Playwright config run under Node (they read process.env),
  // so this config names Node's types explicitly (TS 6 loads no @types by
  // default). They sit outside tsconfig.json's include, so `npm run typecheck`
  // (which `npm run build` runs first) checks both configs.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["e2e", "playwright.config.ts"]
}
